# ---- Database ---------------------------------------------------------------
# Privileged owner connection (migrations, ingestion, pipelines). Bypasses RLS.
DATABASE_URL=postgresql://studybuddy_owner:owner_pw@localhost:5433/studybuddy
# Un-privileged app-role connection used by the HTTP API. RLS is FORCED here.
APP_DATABASE_URL=postgresql://studybuddy_app:app_pw@localhost:5433/studybuddy

# ---- Auth -------------------------------------------------------------------
# REQUIRED. Sign session JWTs (HS256). There is intentionally NO default — the
# app refuses to start without it. Generate one:   openssl rand -hex 32
# (The built-in dev sentinel is also rejected unconditionally; in production any
# secret shorter than 32 chars is rejected too.)
JWT_SECRET=
JWT_TTL_SECONDS=604800

# ---- HTTP -------------------------------------------------------------------
PORT=8080

# ---- Module / ingestion -----------------------------------------------------
# Folder of Week N/ notes to ingest. Defaults to the bundled original demo
# corpus; point it at your own notes vault to revise your own material.
VAULT_PATH=./demo/corpus
# Question bank imported when no LLM key is set (grounding is re-checked on import).
AUTHORED_QUESTIONS_PATH=./demo/questions.json
# Max words per notes chunk. 880 for long lecture notes; ~120 for short notes.
NOTES_CHUNK_WORDS=120
MODULE_SLUG=ml
MODULE_NAME=Machine Learning

# ---- AI providers -----------------------------------------------------------
# Keys are read from the environment and kept server-side. Never hardcode them.
# If a key is absent the matching provider defaults to a deterministic "mock"
# so the entire pipeline (ingest -> concepts -> questions -> quiz -> why) runs
# fully offline. Set the *_PROVIDER vars explicitly to override autodetection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | mock   (embeddings)
EMBEDDING_PROVIDER=
# anthropic | mock   (generation / grading / explanations)
LLM_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-4-6

# ---- AI endpoint guardrails -------------------------------------------------
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_BODY_BYTES=16384
MAX_ANSWER_CHARS=4000
# Max login/signup attempts per minute (per IP, and per email on login).
AUTH_RATE_LIMIT_PER_MIN=10

# ---- Public demo (optional) ---------------------------------------------------
# Seeded on boot by `npm run start:prod` and shown on the login page.
DEMO_EMAIL=
DEMO_PASSWORD=
# 1 = enable the one-click "Try the demo" guest login (rate-limited).
DEMO_GUESTS=
GUESTS_PER_HOUR=200
